{
  "name": "server",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx --env-file-if-exists=../.env scripts/build-seed.ts",
    "seed:print-sample": "tsx scripts/print-sample-airports.ts",
    "seed:check-opensky": "tsx scripts/check-opensky.ts",
    "tool": "tsx scripts/run-tool.ts",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.15",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^4.5.1",
    "langchain": "^1.5.11",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
